# Telegram Bot Configuration - Dual Bots for Load Balancing
# Legacy single bot support (backward compatibility)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=your_channel_id_here
NEXT_PUBLIC_TELEGRAM_BOT_NAME=your_bot_name

# Dual Bot Configuration (for production load balancing)
# Bot 2
TELEGRAM_BOT_TOKEN_1=your_bot_1_token_here
TELEGRAM_CHANNEL_ID_1=your_bot_1_channel_id_here

# Bot 2
TELEGRAM_BOT_TOKEN_2=your_bot_2_token_here
TELEGRAM_CHANNEL_ID_2=your_bot_2_channel_id_here

# Image Count Limits (configurable per plan)
FREE_PLAN_MAX_IMAGES=100
PRO_PLAN_MAX_IMAGES=10000
ENTERPRISE_PLAN_MAX_IMAGES=100000

